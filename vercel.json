{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/absetup.exe",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Disposition": "attachment; filename=\"absetup.exe\""
      },
      "dest": "/absetup.exe"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
